<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: uses launcher icon in a circle by default.
         Keep a white background so the handoff to Flutter SplashScreen
         (full splash_logo.png) feels continuous. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <!-- Android 12 masks the icon in a circle — use simple mark, not full emblem. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
